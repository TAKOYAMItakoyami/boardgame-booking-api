# --- Настройки приложения ---
APP_TITLE=Boardgame Booking API
DESCRIPTION=Сервис бронирования настольных игр антикафе Host&Хвост
SECRET=super_secret_key_change_me

# --- Первый суперпользователь (создается при первом запуске) ---
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin_password_change_me

# --- Настройки базы данных ---
# ВАРИАНТ 1: Для запуска в Docker (PostgreSQL)
# Обратите внимание: хост - это "db" (имя сервиса в docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/booking

# ВАРИАНТ 2: Для локальной разработки без Docker (SQLite)
# Чтобы использовать этот вариант, закомментируйте строку выше и раскомментируйте эту:
# DATABASE_URL=sqlite+aiosqlite:///./bgbooking.db

# --- Реквизиты для контейнера PostgreSQL (нужны только для Docker) ---
# Эти значения должны совпадать с данными в DATABASE_URL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=booking

# --- Яндекс Диск (нужен только для эндпоинта отчётов POST /yandex/) ---
# Личная OAuth-заглушка с правом доступа к Яндекс Диску: https://oauth.yandex.ru/
# Переменная оставлена закомментированной: без неё сервис работает,
# а POST /yandex/ отвечает 503 "Яндекс Диск не настроен".
# Раскомментируйте и подставьте свой токен (пустое значение не подойдет):
# YANDEX_DISK_TOKEN=y0__AGlb000000000000000000000000000000000
